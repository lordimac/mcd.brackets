{
  "name": "mcd-brackets",
  "version": "0.27.0-beta",
  "description": "Tournament bracket management system using brackets-manager",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "server": "tsx src/server.ts",
    "server:watch": "tsx watch src/server.ts",
    "vendor": "cp node_modules/brackets-viewer/dist/brackets-viewer.min.js node_modules/html2canvas/dist/html2canvas.min.js node_modules/jspdf/dist/jspdf.umd.min.js public/lib/ && mkdir -p public/lib/fonts && cp node_modules/@fontsource/chakra-petch/files/chakra-petch-latin-{500,600,700}-normal.woff2 public/lib/fonts/",
    "test": "tsx --test 'src/**/*.test.ts'",
    "docker:rebuild": "scripts/docker-rebuild.sh"
  },
  "keywords": [
    "tournament",
    "brackets",
    "manager",
    "elimination",
    "round-robin",
    "double-elimination",
    "event-management",
    "championship",
    "rankings"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lordimac/mcd.brackets.git"
  },
  "bugs": {
    "url": "https://github.com/lordimac/mcd.brackets/issues"
  },
  "homepage": "https://github.com/lordimac/mcd.brackets#readme",
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "brackets-json-db": "^1.0.3",
    "brackets-manager": "^1.11.1",
    "brackets-viewer": "^1.9.1",
    "express": "^5.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "brackets-model": "^1.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
